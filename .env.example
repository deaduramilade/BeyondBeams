# Server configuration
API_KEYS={"replace-with-a-generated-secret":"enterprise"}
HOST=127.0.0.1
PORT=3000

# Expo development configuration
# EXPO_PUBLIC variables are embedded in client builds and must not contain
# privileged production secrets. Use a restricted development credential only.
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000/execute
EXPO_PUBLIC_API_KEY=replace-with-a-restricted-development-key